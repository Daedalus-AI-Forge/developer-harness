{
  "description": "developer-harness guard hooks: scan staged content for credentials before git commit",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/secret-scan.sh"
          }
        ]
      }
    ]
  }
}
